{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paladin.dev/schemas/agent-protocol.schema.json",
  "title": "PALADIN Agent Communication Protocol",
  "description": "The asynchronous message envelope exchanged between the five agents, the simulation engine, and the frontend.",
  "type": "object",
  "required": ["messageId", "timestamp", "from", "type", "payload"],
  "properties": {
    "messageId": { "type": "string" },
    "correlationId": {
      "type": "string",
      "description": "Set on a response to the messageId of the request it answers."
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "from": { "$ref": "#/$defs/agentId" },
    "to": {
      "description": "Omitted for a broadcast message.",
      "$ref": "#/$defs/agentId"
    },
    "type": {
      "type": "string",
      "enum": [
        "status_broadcast",
        "fault_alert",
        "fix_proposal",
        "validation_request",
        "validation_result",
        "commit",
        "rollback"
      ]
    },
    "payload": {
      "description": "Shape depends on the sibling type field, see the allOf conditionals below and the $defs they reference.",
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "status_broadcast" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/statusBroadcastPayload" } } }
    },
    {
      "if": { "properties": { "type": { "const": "fault_alert" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/faultAlertPayload" } } }
    },
    {
      "if": { "properties": { "type": { "const": "fix_proposal" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/fixProposalPayload" } } }
    },
    {
      "if": { "properties": { "type": { "const": "validation_request" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/validationRequestPayload" } } }
    },
    {
      "if": { "properties": { "type": { "const": "validation_result" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/validationResultPayload" } } }
    },
    {
      "if": { "properties": { "type": { "const": "commit" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/commitPayload" } } }
    },
    {
      "if": { "properties": { "type": { "const": "rollback" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/rollbackPayload" } } }
    }
  ],
  "$defs": {
    "agentId": {
      "type": "string",
      "enum": ["orion", "vulcan", "tesla", "mercury", "athena"]
    },
    "statusBroadcastPayload": {
      "type": "object",
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string" },
        "nodeIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "faultAlertPayload": {
      "type": "object",
      "required": ["faultId", "faultType", "affectedNodeIds", "severity"],
      "properties": {
        "faultId": { "type": "string" },
        "faultType": {
          "type": "string",
          "enum": ["solar_flare", "micrometeoroid_puncture", "cooling_breach"]
        },
        "affectedNodeIds": { "type": "array", "items": { "type": "string" } },
        "affectedEdgeIds": { "type": "array", "items": { "type": "string" } },
        "severity": { "type": "string", "enum": ["p1", "p2", "p3"] }
      }
    },
    "fixProposalPayload": {
      "type": "object",
      "required": ["proposalId", "faultId", "action", "targetNodeIds"],
      "properties": {
        "proposalId": { "type": "string" },
        "faultId": { "type": "string" },
        "action": {
          "type": "string",
          "description": "The concrete change being proposed, for example reroute_circuit, migrate_workload, open_coolant_valve."
        },
        "targetNodeIds": { "type": "array", "items": { "type": "string" } },
        "sourceNodeId": {
          "type": "string",
          "description": "The node this fix moves load or traffic away from, used by actions like migrate_workload. Not every action needs one."
        },
        "loadDelta": {
          "type": "number",
          "description": "The magnitude of load this fix moves, in the same units as powerLoadPercent. Used by actions like migrate_workload."
        },
        "expectedEffect": { "type": "string" }
      }
    },
    "validationRequestPayload": {
      "type": "object",
      "required": ["proposalId"],
      "properties": {
        "proposalId": { "type": "string" }
      }
    },
    "validationResultPayload": {
      "type": "object",
      "required": ["proposalId", "verdict", "reasoning"],
      "properties": {
        "proposalId": { "type": "string" },
        "verdict": { "type": "string", "enum": ["pass", "fail"] },
        "reasoning": {
          "type": "string",
          "description": "Human-readable explanation of the verdict, backed by the rule-based checker's constraint evaluation."
        },
        "violatedConstraints": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "commitPayload": {
      "type": "object",
      "required": ["proposalId"],
      "properties": {
        "proposalId": { "type": "string" }
      }
    },
    "rollbackPayload": {
      "type": "object",
      "required": ["proposalId", "reason"],
      "properties": {
        "proposalId": { "type": "string" },
        "reason": { "type": "string" }
      }
    }
  }
}
